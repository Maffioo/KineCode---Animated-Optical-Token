{
  "name": "kinecode-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "KineCode Monorepo — Protocol & SDK (packages/kinecode), Interactive Web Demo (web), and Native Mobile Scanner (mobile)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "scripts": {
    "dev": "npm --workspace=web run dev",
    "dev:https": "npm --workspace=web run dev:https",
    "build": "npm --workspace=kinecode run build && npm --workspace=web run build",
    "build:lib": "npm --workspace=kinecode run build",
    "build:web": "npm --workspace=web run build",
    "preview": "npm --workspace=web run preview",
    "test": "npm --workspace=kinecode run test",
    "test:watch": "npm --workspace=kinecode run test:watch",
    "mobile:start": "npm --prefix mobile start",
    "mobile:tunnel": "npm --prefix mobile run start -- --tunnel"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
