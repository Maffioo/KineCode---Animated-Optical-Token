{
  "name": "kinecode-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "KineCode Monorepo — Protocol & SDK (packages/kinecode), Showcase Landing & Docs (landing), and Native Mobile Scanner (mobile)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maffioo/kinecode.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "landing"
  ],
  "scripts": {
    "dev": "npm --workspace=landing run dev",
    "landing:dev": "npm --workspace=landing run dev",
    "landing:build": "npm --workspace=landing run build",
    "build": "npm --workspace=kinecode run build && npm --workspace=landing run build",
    "build:lib": "npm --workspace=kinecode run build",
    "build:landing": "npm --workspace=landing run build",
    "test": "npm --workspace=kinecode run test",
    "test:watch": "npm --workspace=kinecode run test:watch",
    "mobile:start": "npm --prefix mobile start",
    "mobile:tunnel": "npm --prefix mobile run start -- --tunnel"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
